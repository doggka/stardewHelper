{
  "name": "stardew-helper",
  "productName": "Stardew Helper",
  "version": "1.0.0",
  "private": true,
  "description": "Помощник по узелкам Общественного центра Stardew Valley",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dist": "node scripts/build.mjs && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "do.craft.stardewhelper",
    "productName": "Stardew Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      "install-mods.ps1"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Stardew Helper.exe"
    },
    "electronDownload": {
      "cache": "../.toolchain/electron-cache"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true
  }
}
